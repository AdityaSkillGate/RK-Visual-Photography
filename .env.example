# ==============================================================================
# RK Visual Photography - Environment Configuration Template
# Copy this file to `.env.local` and provide your actual credentials.
# ==============================================================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Public API Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Secret Key (NEVER expose to browser, server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# ImageKit.io Configuration
# ------------------------------------------------------------------------------
# ImageKit Endpoint URL (e.g., https://ik.imagekit.io/rkvisual)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ImageKit Public Key (used for client-side uploads and transforms)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key

# ImageKit Private Key (server-side only, used for auth/signing uploads)
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
